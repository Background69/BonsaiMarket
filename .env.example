# Development only; set a private value in .env or your shell.
DB_URL=jdbc:mysql://localhost:3306/bonsai_market
DB_USERNAME=bonsai
DB_PASSWORD=change-me
SPRING_PROFILES_ACTIVE=dev
MYSQL_ROOT_PASSWORD=change-root-password

# Server process only. IntelliJ does not load this file automatically.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=

# Generate with: openssl rand -base64 32   (PowerShell: [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256})))
AUTH_OTP_HMAC_KEY=
AUTH_FRONTEND_ORIGIN=http://localhost:5173
AUTH_PUBLIC_ORIGIN=http://localhost:5173
# false is for HTTP localhost development only; production HTTPS requires true.
AUTH_COOKIE_SECURE=false

# ---- Real SMTP (verification + password reset emails) ----
# Gmail: MAIL_HOST=smtp.gmail.com, port 587, STARTTLS=true. MAIL_USERNAME = your Gmail address,
#        MAIL_PASSWORD = 16-character App Password (Google Account > Security > 2-Step Verification > App passwords),
#        written without spaces. MAIL_FROM must equal MAIL_USERNAME.
# Port 465 instead: MAIL_PORT=465, MAIL_SMTP_SSL=true, MAIL_SMTP_STARTTLS=false.
# Local fake inbox (docker compose mailpit, http://localhost:8025): MAIL_HOST=localhost, MAIL_PORT=1025,
#        MAIL_SMTP_AUTH=false, MAIL_SMTP_STARTTLS=false, MAIL_FROM=no-reply@bonsaimarket.local
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_SSL=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_API_VERSION=
