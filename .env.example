# Development only. Copy this file to .env and fill in the empty values.
DB_URL=jdbc:mysql://localhost:3306/bonsai_market
DB_USERNAME=bonsai
DB_PASSWORD=change-me
SPRING_PROFILES_ACTIVE=dev
MYSQL_ROOT_PASSWORD=change-root-password

# Server process only.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=

# Required. Generate with: openssl rand -base64 32
# (PowerShell: [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256})))
AUTH_OTP_HMAC_KEY=
AUTH_FRONTEND_ORIGIN=http://localhost:5173
AUTH_PUBLIC_ORIGIN=http://localhost:5173
# false is for HTTP localhost development only; production HTTPS requires true.
AUTH_COOKIE_SECURE=false

# ---- Email (verification + password reset) ----
# Default: local fake inbox Mailpit (docker compose up -d). Read codes at http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@bonsaimarket.local
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_SSL=false
# Real Gmail instead: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SMTP_AUTH=true,
# MAIL_SMTP_STARTTLS=true, MAIL_USERNAME and MAIL_FROM = your Gmail address,
# MAIL_PASSWORD = 16-character App Password written without spaces.
# Port 465: MAIL_PORT=465, MAIL_SMTP_SSL=true, MAIL_SMTP_STARTTLS=false.

# ---- Social login (optional; ask the team lead for the keys) ----
# Redirect URIs: http://localhost:5173/login/oauth2/code/google and .../facebook
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_API_VERSION=v26.0