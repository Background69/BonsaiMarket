# Development only; set a private value in .env or your shell.
# Chỉ chọn database MỚI đã xác minh trống; không dùng DB nhóm cũ với baseline mới.
DB_URL=jdbc:mysql://localhost:3306/bonsaimarket_dev_new
DB_USERNAME=bonsai
DB_PASSWORD=change-me
SPRING_PROFILES_ACTIVE=dev
DEV_SEED_PASSWORD_HASH=
MYSQL_ROOT_PASSWORD=change-root-password

# Server process only. IntelliJ does not load this file automatically.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=

# Generate with: openssl rand -base64 32   (PowerShell: [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256})))
AUTH_OTP_HMAC_KEY=
AUTH_FRONTEND_ORIGIN=http://localhost:5173
AUTH_PUBLIC_ORIGIN=http://localhost:5173
# false is for HTTP localhost development only; production HTTPS requires true.
AUTH_COOKIE_SECURE=false

# ---- Real SMTP (verification + password reset emails) ----
# Gmail: MAIL_HOST=smtp.gmail.com, port 587, STARTTLS=true. MAIL_USERNAME = your Gmail address,
#        MAIL_PASSWORD = 16-character App Password (Google Account > Security > 2-Step Verification > App passwords),
#        written without spaces. MAIL_FROM must equal MAIL_USERNAME.
# Port 465 instead: MAIL_PORT=465, MAIL_SMTP_SSL=true, MAIL_SMTP_STARTTLS=false.
# Local fake inbox (docker compose mailpit, http://localhost:8025): MAIL_HOST=localhost, MAIL_PORT=1025,
#        MAIL_SMTP_AUTH=false, MAIL_SMTP_STARTTLS=false, MAIL_FROM=no-reply@bonsaimarket.local
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_SSL=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_API_VERSION=

# Checkout/COD: staging only. These server-side secrets must never use VITE_* variables.
SHIPPING_GHN_ENABLED=false
SHIPPING_GHN_TOKEN=
SHIPPING_GHN_WEBHOOK_SECRET=
ORDER_MAIL_ENABLED=false
# Configure shipping.ghn.shop-ids and cod-enabled-store-ids per approved store in server configuration.
# Every store requires a distinct platform-owned staging ShopId; leave maps/allowlists empty until reviewed.
# IntelliJ must receive the intended variables explicitly; Docker .env is not automatically Spring configuration.
# VNPAY sandbox: chỉ bật khi có cấu hình riêng đã được xác nhận trên server.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
