# Development only; set a private value in .env or your shell.
DB_URL=jdbc:mysql://localhost:3306/bonsai_market
DB_USERNAME=bonsai
DB_PASSWORD=change-me
SPRING_PROFILES_ACTIVE=dev
MYSQL_ROOT_PASSWORD=change-root-password

# Server process only. IntelliJ does not load this file automatically.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=

AUTH_OTP_HMAC_KEY=
AUTH_FRONTEND_ORIGIN=http://localhost:5173
AUTH_PUBLIC_ORIGIN=http://localhost:5173
# false is for HTTP localhost development only; production HTTPS requires true.
AUTH_COOKIE_SECURE=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_API_VERSION=

# Checkout/COD: staging only. These server-side secrets must never use VITE_* variables.
SHIPPING_GHN_ENABLED=false
SHIPPING_GHN_TOKEN=
SHIPPING_GHN_WEBHOOK_SECRET=
ORDER_MAIL_ENABLED=false
# Configure shipping.ghn.shop-ids and cod-enabled-store-ids per approved store in server configuration.
# Every store requires a distinct platform-owned staging ShopId; leave maps/allowlists empty until reviewed.
# IntelliJ must receive the intended variables explicitly; Docker .env is not automatically Spring configuration.