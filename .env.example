DB_URL=jdbc:mysql://localhost:3306/bonsai_market_dev_new
DB_USERNAME=bonsai
DB_PASSWORD=change-me
SPRING_PROFILES_ACTIVE=dev
MYSQL_ROOT_PASSWORD=change-root-password

AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=

AUTH_OTP_HMAC_KEY=
AUTH_FRONTEND_ORIGIN=http://localhost:5173
AUTH_PUBLIC_ORIGIN=http://localhost:5173
AUTH_COOKIE_SECURE=false

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_SSL=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
